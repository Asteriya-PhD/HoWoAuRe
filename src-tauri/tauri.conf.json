{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "作业扫码登记",
  "version": "1.2.0",
  "identifier": "com.homeworkscan.local",
  "mainBinaryName": "homework-scan",
  "build": {
    "frontendDist": "../app-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "作业扫码登记",
        "url": "index.html",
        "width": 1240,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "resources/public": "public"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
